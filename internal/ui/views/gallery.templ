package views

import (
	"github.com/deastl/artifact-host/internal/model"
	"github.com/deastl/artifact-host/internal/ui/components/aspectratio"
	"github.com/deastl/artifact-host/internal/ui/components/badge"
	"github.com/deastl/artifact-host/internal/ui/components/button"
	"github.com/deastl/artifact-host/internal/ui/components/card"
	"github.com/deastl/artifact-host/internal/ui/components/icon"
	"github.com/deastl/artifact-host/internal/ui/components/input"
	"github.com/deastl/artifact-host/internal/ui/components/separator"
)

templ Gallery(data GalleryData) {
	@Layout("Artifact Host", "min-h-screen bg-background text-foreground antialiased") {
		<header class="sticky top-0 z-30 border-b bg-background/95 backdrop-blur-sm">
			<div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
				<a href="/" class="flex items-center gap-2.5 text-sm font-semibold tracking-tight text-foreground">
					<span class="flex size-7 items-center justify-center rounded-lg border bg-muted/60 text-foreground">
						@icon.Layers(icon.Props{Class: "size-4"})
					</span>
					<span>Artifact Host</span>
				</a>
				<div class="flex items-center gap-3">
					<div class="hidden items-center gap-2.5 text-xs text-muted-foreground sm:flex">
						<span>{ Pluralize(effectiveArtifactCount(data), "artifact", "artifacts") }</span>
						@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-3.5"})
						<span>{ Pluralize(effectiveVersionCount(data), "version", "versions") }</span>
						@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-3.5"})
						<span>{ Pluralize(data.Status.PreviewCacheCount, "preview", "previews") }</span>
					</div>
					@badge.Badge(badge.Props{
						Variant: badge.VariantOutline,
						Class:   "gap-1.5 font-mono text-[11px] font-normal text-muted-foreground",
					}) {
						<span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
						<span>{ statusAddrLabel(data.Status) }</span>
					}
					@themeToggleButton()
				</div>
			</div>
		</header>
		<main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">
			<section class="space-y-3" aria-label="Filter artifacts">
				<form method="GET" action="/" class="flex flex-col gap-2 sm:flex-row sm:items-center">
					if data.ActiveTag != "" {
						<input type="hidden" name="tag" value={ data.ActiveTag }/>
					}
					<div class="relative flex-1">
						@icon.Search(icon.Props{Class: "pointer-events-none absolute left-2.5 top-1/2 size-4 -translate-y-1/2 text-muted-foreground"})
						@input.Input(input.Props{
							Name:        "q",
							Type:        "search",
							Value:       data.Query,
							Placeholder: "Search artifacts by title, slug, or description...",
							Class:       "h-9 pl-8",
							Attributes: templ.Attributes{
								"aria-label": "Search artifacts",
							},
						})
					</div>
					<div class="flex items-center gap-2">
						@button.Button(button.Props{
							Type:    button.TypeSubmit,
							Variant: button.VariantOutline,
							Size:    button.SizeLg,
							Class:   "px-3.5",
						}) {
							Search
						}
						if data.Query != "" || data.ActiveTag != "" {
							@button.Button(button.Props{
								Href:    "/",
								Variant: button.VariantGhost,
								Size:    button.SizeLg,
								Class:   "px-3 text-muted-foreground",
							}) {
								Reset
							}
						}
					</div>
				</form>
				if len(data.AllTags) > 0 {
					<div class="flex flex-wrap items-center gap-1.5" role="navigation" aria-label="Filter by tag">
						@badge.Badge(badge.Props{
							Href:    galleryFilterURL(data.Query, ""),
							Variant: tagBadgeVariant(data.ActiveTag == ""),
							Class:   "h-6 px-2.5",
						}) {
							All
						}
						for _, tag := range data.AllTags {
							@badge.Badge(badge.Props{
								Href:    galleryFilterURL(data.Query, tag),
								Variant: tagBadgeVariant(data.ActiveTag == tag),
								Class:   "h-6 px-2.5",
							}) {
								{ tag }
							}
						}
					</div>
				}
			</section>
			if len(data.Artifacts) > 0 {
				<section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" aria-label="Hosted artifacts">
					for _, art := range data.Artifacts {
						@artifactCard(art, data.Query)
					}
				</section>
			} else {
				@galleryEmptyState(data.Query != "" || data.ActiveTag != "")
			}
		</main>
	}
}

func tagBadgeVariant(active bool) badge.Variant {
	if active {
		return badge.VariantDefault
	}
	return badge.VariantSecondary
}

templ artifactCard(art model.Artifact, currentQuery string) {
	{{ eff := art.EffectiveVersion() }}
	{{ isPending := art.LatestPreviewStatus == model.PreviewPending }}
	@card.Card(card.Props{Class: "group/artifact overflow-hidden pt-0 transition-shadow hover:shadow-md"}) {
		<a
			href={ templ.SafeURL(artifactURL(art.Slug)) }
			data-preview-frame="true"
			class="relative block overflow-hidden border-b bg-muted/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
		>
			@aspectratio.AspectRatio(aspectratio.Props{Ratio: "16/10", Class: "w-full overflow-hidden bg-muted/30"}) {
				<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-muted-foreground/50" aria-hidden="true">
					@ArtifactIcon(art.Icon, icon.Props{Class: "size-8"})
					<span class="font-mono text-[11px]">{ art.Slug }</span>
				</div>
				<img
					src={ previewURL(art.Slug, eff, art.LatestContentHash) }
					alt={ displayTitle(art.Title, art.Slug) + " preview" }
					loading="lazy"
					data-preview-img="true"
					data-slug={ art.Slug }
					data-version={ itoa(eff) }
					if isPending {
						data-preview-pending="true"
					}
					class="relative z-10 h-full w-full object-cover object-top transition-transform duration-300 group-hover/artifact:scale-[1.02]"
				/>
				if isPending {
					<div
						data-preview-status-badge="true"
						class="absolute right-2.5 top-2.5 z-20 inline-flex items-center gap-1.5 rounded-full border bg-background/90 px-2 py-0.5 text-[11px] font-medium text-muted-foreground shadow-xs backdrop-blur-xs"
					>
						<span class="size-1.5 animate-pulse rounded-full bg-amber-500" aria-hidden="true"></span>
						<span>Rendering</span>
					</div>
				}
			}
		</a>
		@card.Header(card.HeaderProps{Class: "gap-1.5 pb-0"}) {
			<div class="flex items-start justify-between gap-2">
				<a
					href={ templ.SafeURL(artifactURL(art.Slug)) }
					class="flex min-w-0 items-center gap-2 text-foreground hover:underline underline-offset-4"
				>
					<span class="flex size-7 shrink-0 items-center justify-center rounded-md border bg-muted/50 text-foreground">
						@ArtifactIcon(art.Icon, icon.Props{Class: "size-3.5"})
					</span>
					@card.Title(card.TitleProps{Class: "truncate text-sm font-semibold"}) {
						{ displayTitle(art.Title, art.Slug) }
					}
				</a>
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "shrink-0 font-mono text-[11px]"}) {
					v{ itoa(eff) }
				}
			</div>
			<div class="flex items-center gap-1.5 text-xs text-muted-foreground">
				<span class="truncate font-mono text-[11px]">{ art.Slug }</span>
				<span aria-hidden="true">·</span>
				<span class="shrink-0">{ RelativeTime(art.UpdatedAt) }</span>
			</div>
		}
		@card.Content(card.ContentProps{Class: "flex flex-1 flex-col gap-3 pt-0"}) {
			if art.Description != "" {
				<p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground">{ art.Description }</p>
			} else {
				<p class="line-clamp-2 text-xs leading-relaxed text-muted-foreground/60">No description provided.</p>
			}
			if len(art.Tags) > 0 {
				<div class="flex flex-wrap items-center gap-1.5">
					for _, tag := range art.Tags {
						@badge.Badge(badge.Props{
							Href:    galleryFilterURL(currentQuery, tag),
							Variant: badge.VariantOutline,
							Class:   "text-[11px] font-normal text-muted-foreground hover:text-foreground",
						}) {
							{ tag }
						}
					}
				</div>
			}
		}
		@card.Footer(card.FooterProps{Class: "justify-between gap-2 py-2.5 text-xs text-muted-foreground"}) {
			<div class="flex items-center gap-2.5">
				<span>{ Pluralize(versionCountDisplay(art), "version", "versions") }</span>
				if art.SubmissionCount > 0 {
					<span class="inline-flex items-center gap-1 text-foreground" title={ Pluralize(art.SubmissionCount, "saved submission", "saved submissions") }>
						@icon.Inbox(icon.Props{Class: "size-3.5 text-muted-foreground"})
						<span>{ itoa(art.SubmissionCount) }</span>
					</span>
				}
			</div>
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeXs,
					Attributes: templ.Attributes{
						"data-copy-url": artifactURL(art.Slug),
						"title":         "Copy artifact link",
					},
				}) {
					@icon.Link2(icon.Props{Class: "size-3.5"})
					<span data-copy-label>Copy</span>
				}
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeXs,
					Href:    artifactURL(art.Slug),
				}) {
					<span>Open</span>
					@icon.ArrowUpRight(icon.Props{Class: "size-3.5"})
				}
			</div>
		}
	}
}

templ galleryEmptyState(isFiltered bool) {
	@card.Card(card.Props{Class: "border-dashed bg-muted/20 py-12 shadow-none"}) {
		@card.Content(card.ContentProps{Class: "mx-auto flex max-w-lg flex-col items-center text-center"}) {
			<span class="mb-4 flex size-11 items-center justify-center rounded-xl border bg-background text-muted-foreground">
				if isFiltered {
					@icon.Search(icon.Props{Class: "size-5"})
				} else {
					@icon.Layers(icon.Props{Class: "size-5"})
				}
			</span>
			if isFiltered {
				<h2 class="text-base font-semibold text-foreground">No matching artifacts</h2>
				<p class="mt-1.5 text-sm text-muted-foreground">
					Try adjusting your search query or clearing the active tag filter.
				</p>
				<div class="mt-5">
					@button.Button(button.Props{Href: "/", Variant: button.VariantOutline, Size: button.SizeDefault}) {
						Clear filters
					}
				</div>
			} else {
				<h2 class="text-base font-semibold text-foreground">No artifacts hosted yet</h2>
				<p class="mt-1.5 text-sm text-muted-foreground">
					Push an HTML file or directory from your terminal to host it with automatic version history and thumbnails.
				</p>
				<div class="mt-5 w-full rounded-lg border bg-background px-3.5 py-2.5 text-left">
					<div class="flex items-center gap-2 font-mono text-xs text-foreground">
						@icon.Terminal(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
						<code class="overflow-x-auto whitespace-nowrap">artifact push ./index.html --slug my-artifact --title "My Artifact"</code>
					</div>
				</div>
			}
		}
	}
}
