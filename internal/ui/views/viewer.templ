package views

import (
	"fmt"

	"github.com/deastl/artifact-host/internal/model"
	"github.com/deastl/artifact-host/internal/ui/components/badge"
	"github.com/deastl/artifact-host/internal/ui/components/button"
	"github.com/deastl/artifact-host/internal/ui/components/icon"
	"github.com/deastl/artifact-host/internal/ui/components/separator"
	"github.com/deastl/artifact-host/internal/ui/components/sheet"
	"github.com/deastl/artifact-host/internal/ui/components/tabs"
	"github.com/deastl/artifact-host/internal/ui/components/tooltip"
)

templ Viewer(data ViewerData) {
	{{ versionsDesc := sortedVersionsDesc(data.Versions) }}
	{{ prevNum := prevVersionNumber(versionsDesc, data.Current.Number) }}
	{{ nextNum := nextVersionNumber(versionsDesc, data.Current.Number) }}
	{{ older := isOlderVersion(data.Artifact, data.Current) }}
	@Layout(viewerPageTitle(data), "flex h-screen flex-col overflow-hidden bg-background text-foreground antialiased") {
		<header class="flex h-14 shrink-0 items-center justify-between gap-2 border-b bg-background px-3 sm:gap-4 sm:px-4">
			<div class="flex min-w-0 items-center gap-2">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeSm,
					Href:    "/",
					Class:   "shrink-0 gap-1.5 text-muted-foreground hover:text-foreground",
					Attributes: templ.Attributes{
						"aria-label": "Back to gallery",
					},
				}) {
					@icon.ArrowLeft(icon.Props{Class: "size-4"})
					<span class="hidden sm:inline">Gallery</span>
				}
				@separator.Separator(separator.Props{Orientation: separator.OrientationVertical, Class: "h-5"})
				<div class="flex min-w-0 items-center gap-2">
					<span class="flex size-7 shrink-0 items-center justify-center rounded-md border bg-muted/50 text-foreground">
						@ArtifactIcon(data.Artifact.Icon, icon.Props{Class: "size-3.5"})
					</span>
					<h1 class="truncate text-sm font-semibold text-foreground">
						{ displayTitle(data.Artifact.Title, data.Artifact.Slug) }
					</h1>
					if data.Artifact.Description != "" {
						@tooltip.Tooltip() {
							<span
								class="hidden shrink-0 cursor-default items-center text-muted-foreground hover:text-foreground md:inline-flex"
								tabindex="0"
								aria-label="Artifact description"
								{ tooltip.Trigger(ctx)... }
							>
								@icon.Info(icon.Props{Class: "size-3.5"})
							</span>
							@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideBottom}) {
								{ data.Artifact.Description }
							}
						}
					}
				</div>
			</div>
			<div class="flex shrink-0 items-center gap-1 rounded-lg border bg-muted/40 p-0.5" role="group" aria-label="Version navigation">
				if prevNum > 0 {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIconSm,
						Href:    artifactVersionURL(data.Artifact.Slug, prevNum),
						Attributes: templ.Attributes{
							"title":                  fmt.Sprintf("Previous version v%d ([)", prevNum),
							"aria-label":             fmt.Sprintf("Previous version v%d", prevNum),
							"data-prev-version-href": artifactVersionURL(data.Artifact.Slug, prevNum),
						},
					}) {
						@icon.ChevronLeft(icon.Props{Class: "size-4"})
					}
				} else {
					@button.Button(button.Props{
						Variant:  button.VariantGhost,
						Size:     button.SizeIconSm,
						Disabled: true,
						Attributes: templ.Attributes{
							"title":      "First version",
							"aria-label": "Previous version unavailable",
						},
					}) {
						@icon.ChevronLeft(icon.Props{Class: "size-4"})
					}
				}
				<select
					data-version-select="true"
					data-slug={ data.Artifact.Slug }
					aria-label="Select artifact version"
					class="h-7 max-w-44 cursor-pointer rounded-md border-0 bg-transparent px-2 text-xs font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-ring sm:max-w-64"
				>
					if len(versionsDesc) > 0 {
						for _, v := range versionsDesc {
							<option value={ itoa(v.Number) } selected?={ v.Number == data.Current.Number }>
								{ versionOptionLabel(data.Artifact, v) }
							</option>
						}
					} else {
						<option value={ itoa(data.Current.Number) } selected>
							v{ itoa(data.Current.Number) }
						</option>
					}
				</select>
				if nextNum > 0 {
					@button.Button(button.Props{
						Variant: button.VariantGhost,
						Size:    button.SizeIconSm,
						Href:    artifactVersionURL(data.Artifact.Slug, nextNum),
						Attributes: templ.Attributes{
							"title":                  fmt.Sprintf("Next version v%d (])", nextNum),
							"aria-label":             fmt.Sprintf("Next version v%d", nextNum),
							"data-next-version-href": artifactVersionURL(data.Artifact.Slug, nextNum),
						},
					}) {
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					}
				} else {
					@button.Button(button.Props{
						Variant:  button.VariantGhost,
						Size:     button.SizeIconSm,
						Disabled: true,
						Attributes: templ.Attributes{
							"title":      "Latest version",
							"aria-label": "Next version unavailable",
						},
					}) {
						@icon.ChevronRight(icon.Props{Class: "size-4"})
					}
				}
			</div>
			<div class="flex shrink-0 items-center gap-1.5">
				@button.Button(button.Props{
					Variant: button.VariantGhost,
					Size:    button.SizeIconSm,
					Attributes: templ.Attributes{
						"data-refresh-preview": "true",
						"data-slug":            data.Artifact.Slug,
						"data-version":         itoa(data.Current.Number),
						"title":                "Refresh preview thumbnail",
						"aria-label":           "Refresh preview",
					},
				}) {
					@icon.RefreshCw(icon.Props{Class: "size-4"})
				}
				@themeToggleButton()
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"data-copy-url": artifactVersionURL(data.Artifact.Slug, data.Current.Number),
						"title":         "Copy link to this version",
					},
				}) {
					@icon.Link2(icon.Props{Class: "size-3.5"})
					<span class="hidden md:inline" data-copy-label>Copy link</span>
				}
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Href:    rawVersionURL(data.Artifact.Slug, data.Current.Number),
					Target:  "_blank",
					Attributes: templ.Attributes{
						"rel":   "noopener noreferrer",
						"title": "Open raw artifact in new tab",
					},
				}) {
					@icon.ExternalLink(icon.Props{Class: "size-3.5"})
					<span class="hidden md:inline">Raw</span>
				}
				@viewerDetailsDrawer(data, versionsDesc)
			</div>
		</header>
		if older {
			<div
				data-older-version-banner="true"
				class="flex shrink-0 flex-wrap items-center justify-between gap-2 border-b bg-amber-50/90 px-4 py-1.5 text-xs text-amber-950 dark:bg-amber-950/40 dark:text-amber-100"
			>
				<div class="flex items-center gap-2 font-medium">
					@icon.History(icon.Props{Class: "size-3.5 shrink-0"})
					<span>Viewing v{ itoa(data.Current.Number) } — latest is v{ itoa(data.Artifact.LatestVersion) }</span>
				</div>
				<div class="flex items-center gap-2">
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeXs,
						Href:    artifactURL(data.Artifact.Slug),
						Class:   "bg-background text-foreground",
					}) {
						Jump to latest
					}
					@button.Button(button.Props{
						Variant: button.VariantDefault,
						Size:    button.SizeXs,
						Attributes: templ.Attributes{
							"data-rollback-version": "true",
							"data-slug":             data.Artifact.Slug,
							"data-version":          itoa(data.Current.Number),
						},
					}) {
						@icon.RotateCcw(icon.Props{Class: "size-3"})
						<span>Restore as latest</span>
					}
				</div>
			</div>
		}
		<iframe
			src={ rawVersionURL(data.Artifact.Slug, data.Current.Number) }
			title={ displayTitle(data.Artifact.Title, data.Artifact.Slug) }
			class="min-h-0 flex-1 w-full border-0 bg-background"
		></iframe>
	}
}

templ viewerDetailsDrawer(data ViewerData, versionsDesc []model.Version) {
	@sheet.Sheet(sheet.Props{ID: "artifact-details-sheet"}) {
		@button.Button(button.Props{
			Variant:    button.VariantSecondary,
			Size:       button.SizeSm,
			Attributes: sheet.Trigger(ctx),
		}) {
			@icon.PanelRight(icon.Props{Class: "size-3.5"})
			<span class="hidden sm:inline">Details</span>
		}
		@sheet.Content(sheet.ContentProps{
			Side:  sheet.SideRight,
			Class: "flex w-full flex-col gap-0 p-0 sm:max-w-md",
		}) {
			@sheet.Header(sheet.HeaderProps{Class: "border-b px-5 py-4 pr-12"}) {
				@sheet.Title() {
					{ displayTitle(data.Artifact.Title, data.Artifact.Slug) }
				}
				@sheet.Description(sheet.DescriptionProps{Class: "font-mono text-xs"}) {
					{ data.Artifact.Slug } · v{ itoa(data.Current.Number) }
				}
			}
			<div class="flex-1 overflow-y-auto px-5 py-4">
				if data.Artifact.Description != "" {
					<p class="text-xs leading-relaxed text-muted-foreground">{ data.Artifact.Description }</p>
				}
				if len(data.Artifact.Tags) > 0 {
					<div class="mt-3 flex flex-wrap gap-1.5">
						for _, tag := range data.Artifact.Tags {
							@badge.Badge(badge.Props{
								Href:    galleryFilterURL("", tag),
								Variant: badge.VariantOutline,
								Class:   "text-[11px] font-normal",
							}) {
								{ tag }
							}
						}
					</div>
				}
				<dl class="mt-4 grid grid-cols-2 gap-2 rounded-lg border bg-muted/30 p-3 text-xs">
					<div>
						<dt class="text-muted-foreground">Entry file</dt>
						<dd class="mt-0.5 truncate font-mono text-foreground">{ fallbackStr(data.Current.EntryFile, "index.html") }</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Total size</dt>
						<dd class="mt-0.5 font-mono text-foreground">{ FormatBytes(data.Current.TotalSize) }</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Published</dt>
						<dd class="mt-0.5 text-foreground">{ RelativeTime(data.Current.CreatedAt) }</dd>
					</div>
					<div>
						<dt class="text-muted-foreground">Content hash</dt>
						<dd class="mt-0.5 truncate font-mono text-foreground">{ fallbackStr(shortHash(data.Current.ContentHash), "-") }</dd>
					</div>
				</dl>
				@tabs.Tabs(tabs.Props{DefaultValue: "versions", Class: "mt-5"}) {
					@tabs.List(tabs.ListProps{Class: "grid w-full grid-cols-3"}) {
						@tabs.Trigger(tabs.TriggerProps{Value: "versions"}) {
							Versions ({ itoa(len(versionsDesc)) })
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "files"}) {
							Files ({ itoa(len(data.Current.Assets)) })
						}
						@tabs.Trigger(tabs.TriggerProps{Value: "submissions"}) {
							Submissions ({ itoa(len(data.Submissions)) })
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "versions", Class: "mt-3 space-y-2"}) {
						if len(versionsDesc) > 0 {
							for _, v := range versionsDesc {
								@versionRow(data.Artifact, data.Current, v)
							}
						} else {
							<p class="py-6 text-center text-xs text-muted-foreground">No version history available.</p>
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "files", Class: "mt-3 space-y-1.5"}) {
						if len(data.Current.Assets) > 0 {
							for _, asset := range data.Current.Assets {
								<div class="flex items-center justify-between gap-2 rounded-lg border px-3 py-2 text-xs">
									<div class="flex min-w-0 items-center gap-2">
										@icon.File(icon.Props{Class: "size-3.5 shrink-0 text-muted-foreground"})
										<div class="min-w-0">
											<p class="truncate font-mono text-foreground">{ asset.Path }</p>
											<p class="text-[11px] text-muted-foreground">
												{ FormatBytes(asset.Size) }
												if asset.ContentType != "" {
													<span> · { asset.ContentType }</span>
												}
											</p>
										</div>
									</div>
									@button.Button(button.Props{
										Variant: button.VariantGhost,
										Size:    button.SizeIconXs,
										Href:    rawAssetURL(data.Artifact.Slug, data.Current.Number, asset.Path),
										Target:  "_blank",
										Attributes: templ.Attributes{
											"rel":        "noopener noreferrer",
											"title":      "Open raw file",
											"aria-label": "Open " + asset.Path,
										},
									}) {
										@icon.ExternalLink(icon.Props{Class: "size-3.5"})
									}
								</div>
							}
						} else {
							<p class="py-6 text-center text-xs text-muted-foreground">No asset manifest recorded for this version.</p>
						}
					}
					@tabs.Content(tabs.ContentProps{Value: "submissions", Class: "mt-3 space-y-2"}) {
						if len(data.Submissions) > 0 {
							for _, sub := range data.Submissions {
								<div class="rounded-lg border p-3 text-xs">
									<div class="flex items-start justify-between gap-2">
										<div class="min-w-0">
											<p class="truncate font-mono font-medium text-foreground">{ sub.Filename }</p>
											<p class="mt-0.5 text-[11px] text-muted-foreground">
												v{ itoa(sub.Version) } · { FormatBytes(sub.Size) } · { RelativeTime(sub.CreatedAt) }
											</p>
										</div>
										<div class="flex shrink-0 items-center gap-1">
											@button.Button(button.Props{
												Variant: button.VariantGhost,
												Size:    button.SizeXs,
												Attributes: templ.Attributes{
													"data-copy-submission": "true",
													"data-submission-url":  submissionURL(data.Artifact.Slug, sub.ID),
													"title":                "Copy submission payload",
												},
											}) {
												@icon.Copy(icon.Props{Class: "size-3"})
												<span data-copy-label>Copy</span>
											}
											@button.Button(button.Props{
												Variant: button.VariantOutline,
												Size:    button.SizeIconXs,
												Href:    submissionURL(data.Artifact.Slug, sub.ID),
												Attributes: templ.Attributes{
													"download":   sub.Filename,
													"title":      "Download submission",
													"aria-label": "Download " + sub.Filename,
												},
											}) {
												@icon.Download(icon.Props{Class: "size-3"})
											}
										</div>
									</div>
								</div>
							}
						} else {
							<div class="rounded-lg border border-dashed px-4 py-6 text-center text-xs text-muted-foreground">
								<p class="font-medium text-foreground">No saved submissions yet</p>
								<p class="mt-1">Files saved from this artifact via <code class="font-mono">window.artifact.save()</code> appear here.</p>
							</div>
						}
					}
				}
			</div>
			@sheet.Footer(sheet.FooterProps{Class: "flex-row items-center justify-between border-t px-5 py-3"}) {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"data-delete-artifact": "true",
						"data-slug":            data.Artifact.Slug,
					},
				}) {
					@icon.Trash2(icon.Props{Class: "size-3.5"})
					<span>Delete artifact</span>
				}
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: sheet.Close(ctx),
				}) {
					Close
				}
			}
		}
	}
}

templ versionRow(art model.Artifact, current model.Version, v model.Version) {
	{{ isCurrent := v.Number == current.Number }}
	{{ isLatest := v.Number == art.LatestVersion }}
	<div class={ versionRowClass(isCurrent) }>
		<div class="flex items-start justify-between gap-2">
			<a href={ templ.SafeURL(artifactVersionURL(art.Slug, v.Number)) } class="min-w-0 flex-1 space-y-1">
				<div class="flex flex-wrap items-center gap-1.5">
					<span class="font-mono text-xs font-semibold text-foreground">v{ itoa(v.Number) }</span>
					if isLatest {
						@badge.Badge(badge.Props{Variant: badge.VariantDefault, Class: "h-4 px-1.5 text-[10px]"}) {
							latest
						}
					}
					if isCurrent {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "h-4 px-1.5 text-[10px]"}) {
							viewing
						}
					}
				</div>
				if v.Note != "" {
					<p class="text-xs text-foreground/90">{ v.Note }</p>
				}
				<p class="text-[11px] text-muted-foreground">
					{ RelativeTime(v.CreatedAt) }
					if v.FileCount > 0 {
						<span> · { Pluralize(v.FileCount, "file", "files") }</span>
					}
					if v.TotalSize > 0 {
						<span> · { FormatBytes(v.TotalSize) }</span>
					}
				</p>
			</a>
			if !isLatest {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeXs,
					Attributes: templ.Attributes{
						"data-rollback-version": "true",
						"data-slug":             art.Slug,
						"data-version":          itoa(v.Number),
						"title":                 fmt.Sprintf("Restore v%d as latest", v.Number),
					},
				}) {
					@icon.RotateCcw(icon.Props{Class: "size-3"})
					<span>Restore</span>
				}
			}
		</div>
	</div>
}

func versionRowClass(isCurrent bool) string {
	if isCurrent {
		return "rounded-lg border border-foreground/25 bg-muted/50 p-3 text-xs"
	}
	return "rounded-lg border p-3 text-xs transition-colors hover:bg-muted/30"
}

func fallbackStr(s, def string) string {
	if s != "" {
		return s
	}
	return def
}
